# Copy to .env for local development. Never commit .env.
# Configure a private database connection and a unique, random JWT_SECRET of at least 32 bytes.

# Vercel Production Environment Variables (Postgres):
# Automatically provided when you connect Vercel Postgres / Neon / Supabase:
DATABASE_URL="postgres://default:password@ep-sample-123.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"

# Secret key for admin session authentication:
JWT_SECRET="patel_samaj_nikol_naroda_secret_key_2026_trust_secure"


# Required only when running the administrator seed script. Use unique, temporary values.
BOOTSTRAP_SUPER_ADMIN_PASSWORD=replace-with-a-unique-temporary-password
BOOTSTRAP_ADMIN_2_PASSWORD=replace-with-a-unique-temporary-password
BOOTSTRAP_ADMIN_3_PASSWORD=replace-with-a-unique-temporary-password
